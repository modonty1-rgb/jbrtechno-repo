# ============================================================
# Dashboard app — local env template
# ============================================================
# Copy this to `.env.local` and fill values, OR run:
#   vercel link && vercel env pull .env.local
#
# Shared vars (DATABASE_URL, CLOUDINARY_*) come from the root
# `.env.shared.example` and are managed in Vercel Team Shared.
#
# NEVER commit real values.
# ============================================================

# --- NextAuth v5 ---
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=

# --- Clockify (time tracking integration) ---
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Public site URL (used in admin notification links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: only needed when running `tsx scripts/create-admin.ts` ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_ROLE=SUPER_ADMIN
