# ════════════════════════════════════════════════════════════════════════════
#  DASHBOARD — APP-SPECIFIC ENV TEMPLATE
# ════════════════════════════════════════════════════════════════════════════
#  All shared/secret values live in ../../.env.shared (JBRTECHNO_ prefixed).
#  This file holds ONLY what NextAuth library reads by exact name.
# ════════════════════════════════════════════════════════════════════════════

# NextAuth v5 (can't rename — library reads by exact name)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
