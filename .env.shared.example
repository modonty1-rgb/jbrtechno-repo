# ════════════════════════════════════════════════════════════════════════════
#  JBRTECHNO MONOREPO — SHARED ENVIRONMENT VARIABLES (TEMPLATE)
# ════════════════════════════════════════════════════════════════════════════
#  Copy this file to .env.shared (gitignored) and fill in real values.
#  Loaded by next.config.ts in apps/dashboard + apps/homepage (via dotenv).
#  Priority: <app>/.env.local > <app>/.env > .env.shared
#
#  Naming: JBRTECHNO_ prefix to avoid conflicts with other products
#  in the same Vercel team (Vercel enforces unique key names per team).
# ════════════════════════════════════════════════════════════════════════════


# 1. CORE INFRASTRUCTURE
JBRTECHNO_DATABASE_URL=


# 2. STORAGE & MEDIA — CLOUDINARY
JBRTECHNO_CLOUDINARY_CLOUD_NAME=
JBRTECHNO_CLOUDINARY_API_KEY=
JBRTECHNO_CLOUDINARY_API_SECRET=


# 3. CLOCKIFY INTEGRATION
CLOCKIFY_ENCRYPTION_SECRET=
CLOCKIFY_WORKSPACE_ID=
CLOCKIFY_API_KEY=


# 4. TRANSACTIONAL EMAIL — RESEND
JBRTECHNO_RESEND_API_KEY=
JBRTECHNO_RESEND_FROM_EMAIL=


# 5. ADMIN / OPS
JBRTECHNO_ADMIN_EMAIL=


# 6. PUBLIC (NEXT_PUBLIC_* — exposed to browser at build time)
NEXT_PUBLIC_JBRTECHNO_WHATSAPP_NUMBER=


# 7. TELEGRAM NOTIFICATIONS
JBRTECHNO_TELEGRAM_BOT_TOKEN=
JBRTECHNO_TELEGRAM_CHAT_ID=
