{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "JBRTECHNO_DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_TRUST_HOST",
    "JBRTECHNO_CLOUDINARY_CLOUD_NAME",
    "JBRTECHNO_CLOUDINARY_API_KEY",
    "JBRTECHNO_CLOUDINARY_API_SECRET",
    "CLOCKIFY_ENCRYPTION_SECRET",
    "CLOCKIFY_WORKSPACE_ID",
    "CLOCKIFY_API_KEY",
    "JBRTECHNO_RESEND_API_KEY",
    "JBRTECHNO_RESEND_FROM_EMAIL",
    "JBRTECHNO_ADMIN_EMAIL",
    "NEXT_PUBLIC_JBRTECHNO_WHATSAPP_NUMBER",
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_URL"
  ],
  "globalPassThroughEnv": ["GITHUB_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {},
    "clean": {
      "cache": false
    }
  }
}
