# ============================================================
# JBRTECHNO root .gitignore (monorepo-wide)
# ============================================================

# --- Dependencies ---
node_modules
.pnpm-store
.pnp
.pnp.js

# --- Build outputs ---
.next
.turbo
dist
out
build
*.tsbuildinfo
next-env.d.ts

# --- Env files (NEVER commit real values) ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.shared
# Keep templates
!.env.example
!.env.shared.example

# --- Vercel ---
.vercel

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing ---
coverage

# --- OS ---
.DS_Store
Thumbs.db

# --- IDE ---
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Playwright MCP snapshots (local test artifacts) ---
.playwright-mcp/

# --- Claude Code (per-developer settings, at any depth) ---
**/.claude/settings.local.json

# --- Misc ---
*.pem
